# ============ 对外访问 ============
# 宿主机端口（映射到容器 80）
WEB_PORT=8090

# ============ 安全 ============
# MySQL root 密码，仅首次初始化建库时生效，之后改这里不会改库
DB_PASSWORD=blued123456
# JWT 签名密钥，生产务必改成随机长串：openssl rand -base64 48
JWT_SECRET=please-change-me-to-a-long-random-string
# 首次启动创建的管理员密码
ADMIN_PASSWORD=Admin@Blued2025

# ============ 镜像源（默认已走国内加速，一般不用改） ============
# 指定优先使用的加速站（留空=按 scripts/pull-images.sh 内置列表依次尝试）
MIRROR=
# 单个镜像拉取超时（秒）
PULL_TIMEOUT=300
# 最后是否再试 Docker Hub 直连（0=不试）
TRY_DIRECT=0
# 预构建模式（已有 backend/target/*.jar 与 frontend/dist 时设 1，秒级启动）
PREBUILT=0
